#!/usr/bin/env bash
# pilot CLI launcher. Node >= 22.18 runs the TypeScript sources directly (type stripping).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"; [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"; done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
exec node "$ROOT/src/boot.mjs" "$@"
