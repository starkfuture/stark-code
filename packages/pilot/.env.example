# Development checkouts only. Installed copies read ~/.pilot/config.json instead (see README "Configuration").
# Any setting can be given here as PILOT_<KEY> (the older LOOKOUT_<KEY> still works); real environment variables win.

# PILOT_HOME=~/.pilot                 # where state lives (tests and trials use a private one)
# PILOT_MODE=local                      # local (claude -p) | offline (labelled fixtures) | live (Managed Agents, needs an API key)
# PILOT_CLAUDE_BIN=claude               # binary that runs reviews, e.g. a wrapper for another account
# PILOT_PROFILES=~/.claude              # Claude Code profiles to watch; "*" = every profile the plugin is installed in
# PILOT_EXCLUDE=                        # comma list of folders never watched
# PILOT_DELIVERY=session                # session | inbox (never speak)
# PILOT_SPEAK_SPACING_MIN=30
# PILOT_SPEAK_MIN_CONFIDENCE=0.7
# PILOT_DAILY_BUDGET_CENTS=1000         # rolling 24 h, all repositories
# PILOT_RUN_BUDGET_CENTS=75
# PILOT_MIN_RUN_INTERVAL_MIN=5
# PILOT_ENGINE=claude                    # claude | codex: what checks prompts and answers questions
# PILOT_ENGINE_FALLBACK=1                # use the other engine when the chosen one cannot run
# PILOT_PROMPT_CHECK_MODEL=sonnet         # never haiku
# PILOT_CODEX_BIN=codex
# PILOT_CODEX_MODEL=gpt-6.1-sol
# PILOT_CODEX_DAILY_RUNS=40
# PILOT_NUDGE_TO_SESSION=all             # all (every nudge) | risky (rule+risky >= 0.8) | off
# PILOT_REVIEW_WORK=0                     # 1 = also review finished work (the old job)
# PILOT_MODEL=claude-opus-5-5             # review model (review_work)
# PILOT_QUICK_EFFORT=medium
# PILOT_PROMPT_REVIEW=merge             # merge | early (also review requests before code exists) | off
# PILOT_AUTOSTART=1
# PILOT_DAEMON_IDLE_EXIT_MIN=120

# Agent Engine findings feed (the key is never set here: `lookout engine connect` keeps it in the macOS Keychain):
# PILOT_ENGINE_URL=https://agent-engine.starkfuture.com
# PILOT_ENGINE_POLL_MIN=5
# PILOT_ENGINE_REPOS={"orders-api":"~/Desktop/work/backend-nest"}

# Live mode (hosted Managed Agents) only:
# ANTHROPIC_API_KEY=                      # or `ant auth login`
